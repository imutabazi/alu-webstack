global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    mode http
    default_backend http_back

frontend https_front
    bind *:443 ssl crt /etc/haproxy/certs/www.mutabazi.tech.pem
    mode http
    http-request set-header X-Forwarded-Proto https
    default_backend http_back

backend http_back
    balance roundrobin
    server 7113-web-01 13.40.85.82:80 check
    server 7113-web-02 35.179.127.188:80 check
